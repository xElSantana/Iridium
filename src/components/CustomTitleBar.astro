---
import { getLanguageFromAstro, t } from "../utils/i18n";
import PreferencesMenu from "./PreferencesMenu.astro";
import { FiMinus, FiRefreshCw, FiSquare, FiX } from "react-icons/fi";

const lang = getLanguageFromAstro(Astro);
---

<header class="flex h-10 shrink-0 items-center bg-surface-subtle text-sm text-foreground-secondary">
  <div class="flex h-full shrink-0 items-center px-3" data-tauri-drag-region>
    <img
      alt="Iridium"
      class="block h-full w-auto object-contain py-1.5"
      data-tauri-drag-region
      src="/icon.png"
    />
  </div>
  <PreferencesMenu />
  <a
    class="titlebar-preferences-trigger flex h-8 items-center rounded-md px-3 focus-visible:outline-2 focus-visible:outline-accent"
    href="https://github.com/xElSantana/Iridium"
    id="github-link"
    rel="noopener noreferrer"
    target="_blank"
  >
    GitHub
  </a>
  <div class="h-full flex-1" data-tauri-drag-region></div>
  <button
    aria-label={t("updates.available", lang)}
    data-i18n-aria="updates.available"
    class="flex w-10 cursor-pointer items-center justify-center transition-colors hover:bg-surface-hover focus-visible:bg-surface-hover focus-visible:outline-2 focus-visible:outline-accent disabled:cursor-wait"
    hidden
    id="update-button"
    title={t("updates.available", lang)}
    type="button"
  >
    <FiRefreshCw aria-hidden="true" size={15} />
  </button>
  <div class="flex h-full" id="window-controls">
    <button
      aria-label={t("titleBar.minimize", lang)}
      data-i18n-aria="titleBar.minimize"
      class="flex w-10 cursor-pointer items-center justify-center transition-colors hover:bg-surface-hover focus-visible:bg-surface-hover focus-visible:outline-2 focus-visible:outline-accent"
      data-window-action="minimize"
      type="button"
    >
      <FiMinus aria-hidden="true" size={16} />
    </button>
    <button
      aria-label={t("titleBar.toggleMaximize", lang)}
      data-i18n-aria="titleBar.toggleMaximize"
      class="flex w-10 cursor-pointer items-center justify-center transition-colors hover:bg-surface-hover focus-visible:bg-surface-hover focus-visible:outline-2 focus-visible:outline-accent"
      data-window-action="toggleMaximize"
      type="button"
    >
      <FiSquare aria-hidden="true" size={14} />
    </button>
    <button
      aria-label={t("titleBar.close", lang)}
      data-i18n-aria="titleBar.close"
      class="flex w-10 cursor-pointer items-center justify-center transition-colors hover:bg-danger hover:text-on-accent focus-visible:bg-danger focus-visible:text-on-accent focus-visible:outline-2 focus-visible:outline-accent"
      data-window-action="close"
      type="button"
    >
      <FiX aria-hidden="true" size={16} />
    </button>
  </div>
</header>

<script>
  import { isTauri } from "@tauri-apps/api/core";
  import { getCurrentWindow } from "@tauri-apps/api/window";
  import { relaunch } from "@tauri-apps/plugin-process";
  import { openUrl } from "@tauri-apps/plugin-opener";
  import { check } from "@tauri-apps/plugin-updater";

  const controls = document.querySelector<HTMLDivElement>("#window-controls");
  const githubLink = document.querySelector<HTMLAnchorElement>("#github-link");
  const updateButton = document.querySelector<HTMLButtonElement>("#update-button");
  let availableUpdate: Awaited<ReturnType<typeof check>> = null;

  const translate = (key: string) => {
    const language = window.getCurrentLanguage?.() || "es";
    return window.getTranslation?.(key, language) || key;
  };

  if (updateButton && isTauri()) {
    updateButton.addEventListener("click", async () => {
      if (!availableUpdate) return;

      const message = translate("updates.availableMessage").replace(
        "{{version}}",
        availableUpdate.version,
      );
      if (!window.confirm(message)) return;

      updateButton.disabled = true;
      try {
        await availableUpdate.downloadAndInstall();
        await relaunch();
      } catch {
        updateButton.disabled = false;
        window.alert(translate("updates.installFailed"));
      }
    });

    window.addEventListener("languagechange", () => {
      updateButton.title = translate("updates.available");
    });

    void check()
      .then((update) => {
        availableUpdate = update;
        if (update) {
          updateButton.hidden = false;
          updateButton.title = translate("updates.available");
        }
      })
      .catch(() => {
        console.warn("No se pudo comprobar si hay actualizaciones.");
      });
  }

  githubLink?.addEventListener("click", async (event) => {
    if (!isTauri()) return;

    event.preventDefault();
    try {
      await openUrl(githubLink.href);
    } catch {
      console.error("No se pudo abrir GitHub.");
    }
  });

  if (controls && !isTauri()) {
    controls.hidden = true;
  } else if (controls) {
    const appWindow = getCurrentWindow();

    controls.querySelectorAll<HTMLButtonElement>("[data-window-action]").forEach((button) => {
      button.addEventListener("click", async () => {
        try {
          switch (button.dataset.windowAction) {
            case "minimize":
              await appWindow.minimize();
              break;
            case "toggleMaximize":
              await appWindow.toggleMaximize();
              break;
            case "close":
              await appWindow.close();
              break;
          }
        } catch (error) {
          console.error("No se pudo ejecutar el control de la ventana:", error);
        }
      });
    });
  }
</script>
