---
import { getLanguageFromAstro, t } from "../utils/i18n";
import { DEFAULT_OUTPUT_FORMAT, SUPPORTED_FORMATS } from "../constants/formats";
import FormatDropdown from "./FormatDropdown.tsx";
import FormatDropdownValue from "./FormatDropdownValue";

const lang = getLanguageFromAstro(Astro);
---

<section class="mb-4 text-center" aria-labelledby="page-title">
  <h1
    class="m-0 text-4xl font-extrabold text-foreground inline-flex items-center justify-center gap-2 flex-wrap"
    id="page-title"
  >
    <span data-i18n="converter.titlePrefix">{t("converter.titlePrefix", lang)}</span>
    <FormatDropdown client:only="react" broadcastFormatChange>
      <span
        id="format-dropdown-fallback"
        slot="fallback"
        aria-hidden="true"
        class="inline-flex h-14 w-44 cursor-pointer items-center justify-center gap-2 rounded-lg bg-accent px-4 py-2 text-4xl font-extrabold text-on-accent transition-colors hover:bg-accent-hover"
      >
        <FormatDropdownValue format={DEFAULT_OUTPUT_FORMAT} />
      </span>
    </FormatDropdown>
  </h1>
</section>

<script
  is:inline
  define:vars={{ supportedFormats: SUPPORTED_FORMATS, defaultOutputFormat: DEFAULT_OUTPUT_FORMAT }}
>
  const formatLabel = document.querySelector("#format-dropdown-fallback [data-format-value]");
  if (formatLabel) {
    try {
      const savedFormat = localStorage.getItem("iridium:output-format");
      if (supportedFormats.includes(savedFormat)) formatLabel.textContent = savedFormat;
    } catch {
      formatLabel.textContent = defaultOutputFormat;
    }
  }
</script>
