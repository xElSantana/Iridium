---
import { getTranslations } from "../i18n";

const t = await getTranslations();
---

<section class="text-center" aria-labelledby="page-title">
  <h1 class="m-0 text-[clamp(36px,5vw,46px)] font-[750] leading-[1.12] text-text" id="page-title">
    {t("converter.title")}
  </h1>
  <p class="mx-auto mb-3.75 mt-3 max-w-117.5 text-[15px] leading-[1.55] text-text-secondary">
    {t("converter.description")}
  </p>
</section>
