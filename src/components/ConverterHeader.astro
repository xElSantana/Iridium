---
import { getTranslations } from "../i18n";
import FormatDropdown from "./FormatDropdown.tsx";

const t = await getTranslations();
---

<section class="text-center" aria-labelledby="page-title">
  <h1
    class="m-0 text-4xl font-extrabold text-gray-900 inline-flex items-center justify-center gap-2 flex-wrap"
    id="page-title"
  >
    <span>{t("converter.titlePrefix")}</span>
    <FormatDropdown client:only="react" label={t("converter.selectFormat")} broadcastFormatChange>
      <span
        slot="fallback"
        aria-hidden="true"
        class="inline-flex h-14 w-44 rounded-lg bg-green-600"
      />
    </FormatDropdown>
  </h1>
  <p class="mx-auto mb-4 mt-3 max-w-2xl text-base text-gray-600">{t("converter.description")}</p>
</section>
