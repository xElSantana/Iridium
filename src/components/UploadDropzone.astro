---
import ImageDropzone from "./ImageDropzone";
import { getTranslations } from "../i18n";

const t = await getTranslations();
---

<ImageDropzone
  client:load
  translations={{
    addImages: t("upload.addImages"),
    dropPrompt: t("upload.dropPrompt"),
    selectFiles: t("upload.selectFiles"),
    convertTo: t("upload.convertTo"),
    convertAll: t("upload.convertAll"),
    remove: t("upload.remove"),
    addMore: t("upload.addMore"),
    qualitySettings: t("upload.qualitySettings"),
    qualityLabel: t("optimizer.quality.label"),
    qualityLevels: {
      min: t("upload.qualityLevels.min"),
      recommended: t("upload.qualityLevels.recommended"),
      max: t("upload.qualityLevels.max"),
    },
  }}
/>
