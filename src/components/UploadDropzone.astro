---
import { FiImage, FiUpload, FiPlus, FiSettings, FiZap } from "react-icons/fi";
import { getTranslations } from "../i18n";

const t = await getTranslations();
---

<div class="w-full">
  <!-- Estado inicial: Dropzone vacía -->
  <label
    id="empty-dropzone"
    class="upload-zone grid min-h-64 cursor-pointer place-items-center rounded-2xl border border-dashed border-gray-300 text-center outline outline-dotted outline-gray-300 outline-offset-2 focus-within:outline-2 focus-within:outline-green-600 [&.is-dragging]:outline-2 [&.is-dragging]:outline-green-600 sm:min-h-80 sm:rounded-3xl"
    for="image-input"
  >
    <span class="flex flex-col items-center p-6">
      <span
        class="relative mb-2 grid h-12 w-16 place-items-center text-gray-400"
        aria-hidden="true"
      >
        <FiImage size={42} />
        <span class="absolute bottom-0 -right-1 grid size-6 place-items-center rounded-full bg-green-600 text-white">
          <FiUpload size={15} />
        </span>
      </span>
      <span class="text-base font-bold text-gray-900">{t("upload.addImages")}</span>
      <span class="mt-1.5 text-xs text-gray-500">
        {t("upload.dropPrompt")}{" "}
        <span class="font-bold text-green-600">{t("upload.selectFiles")}</span>
      </span>
    </span>
  </label>

  <!-- Estado con imágenes seleccionadas (Estilo Picflow) -->
  <div
    id="card-preview"
    class="hidden rounded-3xl border border-gray-200 bg-white p-6 shadow-sm transition-all"
    data-label-convert-to={t("upload.convertTo")}
    data-label-remove={t("upload.remove")}
  >
    <!-- Lista de archivos -->
    <div
      id="file-list"
      class="space-y-3 divide-y divide-gray-100 max-h-96 overflow-y-auto pr-3 scrollbar-gutter-stable"
    ></div>

    <!-- Panel expandible de ajustes (calidad) -->
    <div
      id="settings-panel"
      class="hidden mt-4 pt-4 border-t border-gray-100 bg-gray-50 rounded-2xl p-4"
    >
      <div class="flex items-center justify-between text-xs font-semibold text-gray-700 mb-1.5">
        <span>{t("optimizer.quality.label")}</span>
        <span id="quality-val" class="font-mono">
          85%
        </span>
      </div>
      <input
        id="quality-slider"
        type="range"
        min="1"
        max="100"
        value="85"
        class="w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-green-600"
      />
      <div class="flex justify-between text-[10px] text-gray-400 mt-1">
        <span>{t("upload.qualityLevels.min")}</span>
        <span>{t("upload.qualityLevels.recommended")}</span>
        <span>{t("upload.qualityLevels.max")}</span>
      </div>
    </div>

    <!-- Barra inferior de acciones -->
    <div class="flex flex-wrap items-center justify-between gap-3 pt-5 mt-4 border-t border-gray-100">
      <div class="flex items-center gap-2">
        <label
          for="image-input"
          class="inline-flex items-center gap-1.5 px-4 py-2 border border-gray-300 rounded-full text-xs font-semibold text-gray-700 hover:bg-gray-50 cursor-pointer transition-colors"
        >
          <FiPlus size={14} />
          <span>{t("upload.addMore")}</span>
        </label>
      </div>

      <div class="flex items-center gap-2">
        <button
          type="button"
          id="btn-settings"
          class="p-2.5 border border-gray-200 rounded-full text-gray-600 hover:bg-gray-50 hover:text-gray-900 transition-colors cursor-pointer"
          title={t("upload.qualitySettings")}
        >
          <FiSettings size={16} />
        </button>

        <button
          type="button"
          id="btn-convert-all"
          class="inline-flex items-center gap-2 px-6 py-2.5 bg-green-600 hover:bg-green-700 text-white rounded-full text-xs font-bold transition-all shadow-sm hover:shadow cursor-pointer"
        >
          <FiZap size={14} />
          <span>{t("upload.convertAll")}</span>
        </button>
      </div>
    </div>
  </div>

  <input class="sr-only" id="image-input" type="file" accept="image/*" multiple />
</div>

<script is:inline>
  const emptyDropzone = document.querySelector("#empty-dropzone");
  const cardPreview = document.querySelector("#card-preview");
  const fileList = document.querySelector("#file-list");
  const fileInput = document.querySelector("#image-input");
  const btnSettings = document.querySelector("#btn-settings");
  const settingsPanel = document.querySelector("#settings-panel");
  const qualitySlider = document.querySelector("#quality-slider");
  const qualityVal = document.querySelector("#quality-val");

  const IS_WINDOWS = /windows|win32/i.test(navigator.userAgent || "");
  const K_UNIT = IS_WINDOWS ? 1024 : 1000;

  const FORMATS = ["JPG", "PNG", "WEBP", "AVIF"];
  let selectedItems = [];
  let globalFormat = "JPG";

  function formatBytes(bytes) {
    if (!bytes || bytes === 0) return "0 B";
    const sizes = ["B", "KB", "MB", "GB"];
    const i = Math.floor(Math.log(bytes) / Math.log(K_UNIT));
    return `${parseFloat((bytes / Math.pow(K_UNIT, i)).toFixed(1))} ${sizes[i]}`;
  }

  function getFileExtension(filename) {
    return filename.slice(((filename.lastIndexOf(".") - 1) >>> 0) + 2).toUpperCase() || "IMG";
  }

  function clearAllObjectURLs() {
    selectedItems.forEach((item) => {
      if (item.url) URL.revokeObjectURL(item.url);
    });
  }

  function renderFileList() {
    if (!fileList || !cardPreview || !emptyDropzone) return;

    fileList.innerHTML = "";

    if (selectedItems.length === 0) {
      cardPreview.classList.add("hidden");
      emptyDropzone.classList.remove("hidden");
      return;
    }

    emptyDropzone.classList.add("hidden");
    cardPreview.classList.remove("hidden");

    const labelConvertTo = cardPreview.dataset.labelConvertTo || "Convertir a";
    const labelRemove = cardPreview.dataset.labelRemove || "Eliminar";
    const fragment = document.createDocumentFragment();

    selectedItems.forEach((itemData, index) => {
      const { file, url, format = globalFormat } = itemData;

      const itemRow = document.createElement("div");
      itemRow.className = "flex items-center justify-between py-3 first:pt-0 last:pb-0 gap-3";

      const leftCol = document.createElement("div");
      leftCol.className = "flex items-center gap-3.5 min-w-0";

      const thumbWrapper = document.createElement("div");
      thumbWrapper.className =
        "size-12 rounded-xl overflow-hidden bg-gray-100 flex items-center justify-center shrink-0 border border-gray-200";

      const thumbImg = document.createElement("img");
      thumbImg.src = url;
      thumbImg.alt = "";
      thumbImg.className = "w-full h-full object-cover";
      thumbImg.loading = "lazy";
      thumbWrapper.appendChild(thumbImg);

      const metaWrapper = document.createElement("div");
      metaWrapper.className = "min-w-0";

      const titleP = document.createElement("p");
      titleP.className = "font-semibold text-sm text-gray-900 truncate";
      titleP.textContent = file.name;
      titleP.title = file.name;

      const infoP = document.createElement("p");
      infoP.className = "text-xs text-gray-400 font-medium";
      infoP.textContent = `${getFileExtension(file.name)}, ${formatBytes(file.size)}`;

      metaWrapper.appendChild(titleP);
      metaWrapper.appendChild(infoP);
      leftCol.appendChild(thumbWrapper);
      leftCol.appendChild(metaWrapper);

      const rightCol = document.createElement("div");
      rightCol.className = "flex items-center gap-3 shrink-0";

      const labelSpan = document.createElement("span");
      labelSpan.className = "text-xs text-gray-400 hidden sm:inline";
      labelSpan.textContent = labelConvertTo;

      const formatSelect = document.createElement("select");
      formatSelect.className =
        "format-select text-xs font-semibold bg-gray-50 border border-gray-200 rounded-lg px-2.5 py-1.5 focus:outline-none focus:ring-1 focus:ring-green-500 cursor-pointer text-gray-700";
      formatSelect.dataset.index = String(index);

      FORMATS.forEach((fmt) => {
        const opt = document.createElement("option");
        opt.value = fmt.toLowerCase();
        opt.textContent = fmt;
        if (fmt.toUpperCase() === format.toUpperCase()) opt.selected = true;
        formatSelect.appendChild(opt);
      });

      const removeBtn = document.createElement("button");
      removeBtn.type = "button";
      removeBtn.className =
        "btn-remove text-gray-400 hover:text-gray-600 p-1.5 rounded-lg hover:bg-gray-100 transition-colors cursor-pointer";
      removeBtn.title = labelRemove;
      removeBtn.dataset.index = String(index);
      removeBtn.innerHTML =
        '<svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>';

      rightCol.appendChild(labelSpan);
      rightCol.appendChild(formatSelect);
      rightCol.appendChild(removeBtn);

      itemRow.appendChild(leftCol);
      itemRow.appendChild(rightCol);
      fragment.appendChild(itemRow);
    });

    fileList.appendChild(fragment);
  }

  if (fileList) {
    fileList.addEventListener("change", (e) => {
      const select = e.target.closest(".format-select");
      if (!select) return;
      const index = parseInt(select.dataset.index, 10);
      if (!isNaN(index) && selectedItems[index]) {
        selectedItems[index].format = select.value.toUpperCase();
      }
    });

    fileList.addEventListener("click", (e) => {
      const btn = e.target.closest(".btn-remove");
      if (!btn) return;
      e.stopPropagation();
      const index = parseInt(btn.dataset.index, 10);
      if (!isNaN(index) && selectedItems[index]) {
        if (selectedItems[index].url) {
          URL.revokeObjectURL(selectedItems[index].url);
        }
        selectedItems = selectedItems.filter((_, i) => i !== index);
        renderFileList();
      }
    });
  }

  function handleFiles(files) {
    if (!files?.length) return;

    const newFiles = Array.from(files).filter(
      (file) =>
        file.type.startsWith("image/") || /\.(jpe?g|png|webp|avif|gif|bmp|tiff)$/i.test(file.name),
    );

    if (!newFiles.length) return;

    const newItems = newFiles.map((file) => ({
      file,
      url: URL.createObjectURL(file),
      format: globalFormat,
    }));

    selectedItems = [...selectedItems, ...newItems];
    renderFileList();
  }

  if (fileInput) {
    fileInput.addEventListener("change", () => {
      handleFiles(fileInput.files);
      fileInput.value = "";
    });
  }

  function setupDropHandler(el) {
    if (!el) return;
    el.addEventListener("dragover", (e) => {
      e.preventDefault();
      el.classList.add("is-dragging");
    });
    el.addEventListener("dragleave", () => {
      el.classList.remove("is-dragging");
    });
    el.addEventListener("drop", (e) => {
      e.preventDefault();
      el.classList.remove("is-dragging");
      handleFiles(e.dataTransfer?.files ?? null);
    });
  }

  setupDropHandler(emptyDropzone);
  setupDropHandler(cardPreview);

  if (btnSettings && settingsPanel) {
    btnSettings.addEventListener("click", () => {
      settingsPanel.classList.toggle("hidden");
    });
  }

  if (qualitySlider && qualityVal) {
    qualitySlider.addEventListener("input", (e) => {
      qualityVal.textContent = `${e.target.value}%`;
    });
  }

  window.addEventListener("formatChanged", (e) => {
    if (e.detail?.format) {
      globalFormat = e.detail.format.toUpperCase();
      document.querySelectorAll(".format-select").forEach((sel) => {
        sel.value = e.detail.format.toLowerCase();
      });
      selectedItems.forEach((item) => {
        item.format = globalFormat;
      });
    }
  });

  window.addEventListener("beforeunload", clearAllObjectURLs);
</script>
