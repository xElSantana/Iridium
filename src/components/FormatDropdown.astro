---
import { FiChevronDown, FiCheck } from "react-icons/fi";

interface Props {
  formats?: string[];
  defaultFormat?: string;
  ariaLabel?: string;
}

const {
  formats = ["JPG", "PNG", "WEBP", "AVIF", "BMP", "TIFF"],
  defaultFormat = "JPG",
  ariaLabel = "Seleccionar formato",
} = Astro.props;
---

<div class="relative inline-block">
  <button
    type="button"
    class="format-selector px-4 py-2 bg-green-600 text-white rounded-lg font-extrabold text-4xl hover:bg-green-700 transition-colors flex items-center gap-2 cursor-pointer [&[aria-expanded=true]_.chevron-icon]:rotate-180"
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-label={ariaLabel}
  >
    <span class="selected-format">{defaultFormat}</span>
    <FiChevronDown className="w-6 h-6 transition-transform chevron-icon" />
  </button>
  <ul
    class="format-options absolute top-full left-0 mt-2 bg-white border-2 border-gray-200 rounded-lg shadow-xl min-w-full z-50 hidden data-[show=true]:block"
    role="listbox"
  >
    {formats.map((format, index) => (
      <li
        role="option"
        data-format={format.toLowerCase()}
        class:list={[
          "format-option px-4 py-3 hover:bg-gray-100 font-semibold text-lg text-gray-900 flex items-center justify-between cursor-pointer",
          { "border-b border-gray-100": index < formats.length - 1 },
          { "bg-gray-100": format === defaultFormat },
        ]}
      >
        <span>{format}</span>
        <FiCheck
          className={`w-5 h-5 text-green-500 check-icon ${format !== defaultFormat ? "hidden" : ""}`}
        />
      </li>
    ))}
  </ul>
</div>

<script is:inline>
  (function () {
    const selector = document.querySelector(".format-selector");
    const options = document.querySelector(".format-options");
    const selectedFormatSpan = document.querySelector(".selected-format");

    function toggleDropdown(show) {
      const shouldShow =
        show !== undefined ? show : selector?.getAttribute("aria-expanded") !== "true";
      selector?.setAttribute("aria-expanded", shouldShow.toString());
      options?.setAttribute("data-show", shouldShow.toString());
    }

    function closeDropdown() {
      toggleDropdown(false);
    }

    function selectFormat(format) {
      if (selectedFormatSpan) {
        selectedFormatSpan.textContent = format;
      }

      // Remove selected state from all options
      options?.querySelectorAll(".format-option").forEach((li) => {
        li.classList.remove("bg-gray-100");
        const checkIcon = li.querySelector(".check-icon");
        if (checkIcon) {
          checkIcon.classList.add("hidden");
        }
      });

      // Add selected state to the clicked option
      const selectedOption = options?.querySelector(`[data-format="${format.toLowerCase()}"]`);
      if (selectedOption) {
        selectedOption.classList.add("bg-gray-100");
        const checkIcon = selectedOption.querySelector(".check-icon");
        if (checkIcon) {
          checkIcon.classList.remove("hidden");
        }
      }

      closeDropdown();

      window.dispatchEvent(
        new CustomEvent("formatChanged", {
          detail: { format: format.toLowerCase() },
        }),
      );
    }

    // Toggle dropdown
    selector?.addEventListener("click", () => toggleDropdown());

    // Close dropdown when clicking outside
    document.addEventListener("click", (e) => {
      const target = e.target;
      if (!selector?.contains(target) && !options?.contains(target)) {
        closeDropdown();
      }
    });

    // Handle option selection
    options?.querySelectorAll(".format-option").forEach((option) => {
      option.addEventListener("click", () => {
        const format = option.getAttribute("data-format")?.toUpperCase() || "JPG";
        selectFormat(format);
      });
    });

    // Keyboard navigation
    selector?.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        selector.click();
      }
    });

    options?.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        closeDropdown();
        selector?.focus();
      }
    });
  })();
</script>
