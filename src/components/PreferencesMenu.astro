---
import esTranslations from "../i18n/locales/es/translation.json";
import { FiCheck, FiChevronRight } from "react-icons/fi";

const themeOptions = [
  { value: "light", key: "preferences.themeLight", label: esTranslations.preferences.themeLight },
  { value: "dark", key: "preferences.themeDark", label: esTranslations.preferences.themeDark },
];
const languageOptions = [
  {
    value: "es",
    key: "preferences.languageSpanish",
    label: esTranslations.preferences.languageSpanish,
  },
  {
    value: "en",
    key: "preferences.languageEnglish",
    label: esTranslations.preferences.languageEnglish,
  },
];
---

<div class="relative flex h-full items-center" id="preferences">
  <button
    aria-expanded="false"
    aria-haspopup="menu"
    class="titlebar-preferences-trigger flex h-8 cursor-pointer items-center gap-1 rounded-md px-3 focus-visible:outline-2 focus-visible:outline-accent"
    id="preferences-trigger"
    type="button"
  >
    <span data-i18n="preferences.title">{esTranslations.preferences.title}</span>
  </button>
  <div
    aria-label={esTranslations.preferences.title}
    data-i18n-aria="preferences.title"
    class="absolute left-0 top-full z-50 min-w-44 rounded-lg border border-border bg-surface shadow-lg"
    hidden
    id="preferences-menu"
    role="menu"
  >
    <div class="relative">
      <button
        aria-expanded="false"
        aria-haspopup="menu"
        class="flex w-full cursor-pointer items-center justify-between gap-6 rounded-t-lg px-3 py-2 text-left hover:bg-surface-hover focus-visible:bg-surface-hover focus-visible:outline-none"
        id="theme-trigger"
        role="menuitem"
        type="button"
      >
        <span data-i18n="preferences.theme">{esTranslations.preferences.theme}</span>
        <FiChevronRight aria-hidden="true" size={14} />
      </button>
      <div
        aria-label={esTranslations.preferences.theme}
        data-i18n-aria="preferences.theme"
        class="absolute left-full top-0 z-50 min-w-36 overflow-hidden rounded-lg border border-border bg-surface shadow-lg"
        hidden
        id="theme-menu"
        role="menu"
      >
        {themeOptions.map(({ value, key, label }) => (
          <button
            aria-checked="false"
            class="flex w-full cursor-pointer items-center justify-between gap-4 px-3 py-2 text-left hover:bg-surface-hover focus-visible:bg-surface-hover focus-visible:outline-none"
            data-theme-option={value}
            role="menuitemradio"
            type="button"
          >
            <span data-i18n={key}>{label}</span>
            <span class="hidden text-accent" data-theme-check>
              <FiCheck aria-hidden="true" size={14} />
            </span>
          </button>
        ))}
      </div>
    </div>
    <div class="relative border-t border-border/80">
      <button
        aria-expanded="false"
        aria-haspopup="menu"
        class="flex w-full cursor-pointer items-center justify-between gap-6 rounded-b-lg px-3 py-2 text-left hover:bg-surface-hover focus-visible:bg-surface-hover focus-visible:outline-none"
        id="language-trigger"
        role="menuitem"
        type="button"
      >
        <span data-i18n="preferences.language">{esTranslations.preferences.language}</span>
        <FiChevronRight aria-hidden="true" size={14} />
      </button>
      <div
        aria-label={esTranslations.preferences.language}
        data-i18n-aria="preferences.language"
        class="absolute left-full top-0 z-50 min-w-36 overflow-hidden rounded-lg border border-border bg-surface shadow-lg"
        hidden
        id="language-menu"
        role="menu"
      >
        {languageOptions.map(({ value, key, label }) => (
          <button
            aria-checked="false"
            class="flex w-full cursor-pointer items-center justify-between gap-4 px-3 py-2 text-left hover:bg-surface-hover focus-visible:bg-surface-hover focus-visible:outline-none"
            data-language-option={value}
            role="menuitemradio"
            type="button"
          >
            <span data-i18n={key}>{label}</span>
            <span class="hidden text-accent" data-language-check>
              <FiCheck aria-hidden="true" size={14} />
            </span>
          </button>
        ))}
      </div>
    </div>
  </div>
</div>

<script>
  const preferences = document.querySelector<HTMLDivElement>("#preferences");
  const preferencesTrigger = document.querySelector<HTMLButtonElement>("#preferences-trigger");
  const preferencesMenu = document.querySelector<HTMLDivElement>("#preferences-menu");
  const themeTrigger = document.querySelector<HTMLButtonElement>("#theme-trigger");
  const themeMenu = document.querySelector<HTMLDivElement>("#theme-menu");
  const languageTrigger = document.querySelector<HTMLButtonElement>("#language-trigger");
  const languageMenu = document.querySelector<HTMLDivElement>("#language-menu");
  const themeOptions = document.querySelectorAll<HTMLButtonElement>("[data-theme-option]");
  const languageOptions = document.querySelectorAll<HTMLButtonElement>("[data-language-option]");

  const closePreferences = (restoreFocus = false) => {
    if (
      !preferencesTrigger ||
      !preferencesMenu ||
      !themeTrigger ||
      !themeMenu ||
      !languageTrigger ||
      !languageMenu
    )
      return;
    preferencesMenu.hidden = true;
    preferencesTrigger.setAttribute("aria-expanded", "false");
    themeMenu.hidden = true;
    themeTrigger.setAttribute("aria-expanded", "false");
    languageMenu.hidden = true;
    languageTrigger.setAttribute("aria-expanded", "false");
    if (restoreFocus) preferencesTrigger.focus();
  };

  const updateThemeSelection = (mode: string) => {
    themeOptions.forEach((option) => {
      const selected = option.dataset.themeOption === mode;
      option.setAttribute("aria-checked", String(selected));
      const check = option.querySelector<HTMLElement>("[data-theme-check]");
      if (check) check.classList.toggle("hidden", !selected);
    });
  };

  const updateLanguageSelection = (language: string) => {
    languageOptions.forEach((option) => {
      const selected = option.dataset.languageOption === language;
      option.setAttribute("aria-checked", String(selected));
      const check = option.querySelector<HTMLElement>("[data-language-check]");
      if (check) check.classList.toggle("hidden", !selected);
    });
  };

  const applyTheme = (mode: "light" | "dark") => {
    document.documentElement.dataset.theme = mode;
    updateThemeSelection(mode);
  };

  const applyLanguage = (language: "es" | "en") => {
    localStorage.setItem("iridium-language", language);

    if (window.updatePageLanguage) {
      window.updatePageLanguage(language);
    }

    window.dispatchEvent(new CustomEvent("languagechange", { detail: { language } }));

    updateLanguageSelection(language);
    closePreferences();
  };

  if (
    preferences &&
    preferencesTrigger &&
    preferencesMenu &&
    themeTrigger &&
    themeMenu &&
    languageTrigger &&
    languageMenu
  ) {
    const themeMode = document.documentElement.dataset.theme === "dark" ? "dark" : "light";
    updateThemeSelection(themeMode);
    updateLanguageSelection(localStorage.getItem("iridium-language") === "en" ? "en" : "es");

    preferencesTrigger.addEventListener("click", () => {
      const isOpening = preferencesMenu.hidden;
      preferencesMenu.hidden = !isOpening;
      preferencesTrigger.setAttribute("aria-expanded", String(isOpening));
      themeMenu.hidden = true;
      themeTrigger.setAttribute("aria-expanded", "false");
      languageMenu.hidden = true;
      languageTrigger.setAttribute("aria-expanded", "false");
    });

    themeTrigger.addEventListener("click", () => {
      const isOpening = themeMenu.hidden;
      themeMenu.hidden = !isOpening;
      themeTrigger.setAttribute("aria-expanded", String(isOpening));
      if (!themeMenu.hidden) {
        languageMenu.hidden = true;
        languageTrigger.setAttribute("aria-expanded", "false");
      }
    });

    languageTrigger.addEventListener("click", () => {
      const isOpening = languageMenu.hidden;
      languageMenu.hidden = !isOpening;
      languageTrigger.setAttribute("aria-expanded", String(isOpening));
      if (!languageMenu.hidden) {
        themeMenu.hidden = true;
        themeTrigger.setAttribute("aria-expanded", "false");
      }
    });

    themeOptions.forEach((option) => {
      option.addEventListener("click", () => {
        const mode = option.dataset.themeOption;
        if (mode !== "light" && mode !== "dark") return;
        localStorage.setItem("iridium-theme", mode);
        applyTheme(mode);
        closePreferences();
      });
    });

    languageOptions.forEach((option) => {
      option.addEventListener("click", () => {
        const language = option.dataset.languageOption;
        if (language !== "es" && language !== "en") return;
        applyLanguage(language);
      });
    });

    document.addEventListener("click", (event) => {
      if (!preferences.contains(event.target as Node)) closePreferences();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !preferencesMenu.hidden) closePreferences(true);
    });
  }
</script>
