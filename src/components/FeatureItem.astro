---
const { title, description } = Astro.props;
---

<article class="text-center">
  <span class="mx-auto mb-2.5 grid size-12 place-items-center rounded-full border border-gray-200 text-green-600">
    <slot name="icon" />
  </span>
  <h2 class="mb-1.5 mt-0 text-base font-bold text-gray-900">{title}</h2>
  <p class="mx-auto my-0 max-w-sm text-xs text-gray-600">{description}</p>
</article>
