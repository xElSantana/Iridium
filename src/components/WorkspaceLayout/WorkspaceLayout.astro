---
import { FiMoreVertical } from "react-icons/fi";
import { LuListTodo } from "react-icons/lu";
import WorkspaceContent, {
  type WorkspaceContentLabels,
} from "../WorkspaceContent/WorkspaceContent";
import styles from "./WorkspaceLayout.module.css";

interface Props {
  resizeLabel: string;
  sidebarLabel: string;
  tasksLabel: string;
  workspaceContentLabels: WorkspaceContentLabels;
}

const { resizeLabel, sidebarLabel, tasksLabel, workspaceContentLabels } = Astro.props;
---

<div class={styles.workspace} data-workspace data-task-details-restoring>
  <script is:inline>
    (() => {
      try {
        const workspace = document.currentScript?.parentElement;
        if (!workspace) return;

        const sidebarRaw = localStorage.getItem("iridium.workspace.sidebar");
        if (sidebarRaw) {
          const sidebar = JSON.parse(sidebarRaw);
          if (sidebar && typeof sidebar === "object") {
            const MIN = 180;
            const MAX = 320;
            if (sidebar.collapsed) {
              workspace.style.setProperty("--sidebar-width", "0px");
              workspace.setAttribute("data-sidebar-collapsed", "");
            } else if (typeof sidebar.width === "number" && Number.isFinite(sidebar.width)) {
              const width = Math.min(MAX, Math.max(MIN, sidebar.width));
              workspace.style.setProperty("--sidebar-width", `${width}px`);
            }
          }
        }
      } catch (error) {
        console.error("Could not restore workspace layout settings.", error);
      }
    })();
  </script>
  <nav class={styles.activityBar} aria-label={sidebarLabel}>
    <button
      class={styles.activityButton}
      type="button"
      aria-label={tasksLabel}
      title={tasksLabel}
      aria-expanded="true"
      aria-controls="workspace-sidebar"
      data-sidebar-activity
    >
      <LuListTodo aria-hidden="true" />
    </button>
  </nav>
  <aside id="workspace-sidebar" class={styles.sidebar} aria-label={tasksLabel}>
    <div id="workspace-sidebar-content" class={styles.sidebarContentHost}></div>
  </aside>
  <div
    class={styles.resizeHandle}
    role="separator"
    aria-label={resizeLabel}
    aria-orientation="vertical"
    aria-valuemin="0"
    aria-valuenow="240"
    tabindex="0"
    data-resize-handle
  >
    <FiMoreVertical className={styles.resizeIcon} aria-hidden="true" />
  </div>
  <main class={styles.main}>
    <div class={styles.mainContent}>
      <WorkspaceContent client:load labels={workspaceContentLabels} />
    </div>
  </main>
  <div id="workspace-task-details-separator" class={styles.taskDetailsSeparator}></div>
  <div id="workspace-task-details" class={styles.taskDetailsHost}></div>
</div>

<script>
  const MIN_SIDEBAR_WIDTH = 180;
  const MAX_SIDEBAR_WIDTH = 320;
  const ACTIVITY_BAR_WIDTH = 48;
  const MAIN_MIN_WIDTH = 160;
  const WORKSPACE_PADDING = 3;
  const RESIZE_HANDLE_WIDTH = 4;
  const STEP = 16;
  const SIDEBAR_STORAGE_KEY = "iridium.workspace.sidebar";

  document.querySelectorAll<HTMLElement>("[data-workspace]").forEach((workspace) => {
    const handle = workspace.querySelector<HTMLElement>("[data-resize-handle]");
    const activityButton = workspace.querySelector<HTMLButtonElement>("[data-sidebar-activity]");
    if (!handle || !activityButton) return;

    let savedSidebarWidth = 240;
    let savedCollapsedState = false;
    const savedSidebarState = localStorage.getItem(SIDEBAR_STORAGE_KEY);
    if (savedSidebarState !== null) {
      try {
        const state: unknown = JSON.parse(savedSidebarState);
        if (
          typeof state === "object" &&
          state !== null &&
          "width" in state &&
          typeof state.width === "number" &&
          Number.isFinite(state.width) &&
          state.width >= MIN_SIDEBAR_WIDTH &&
          "collapsed" in state &&
          typeof state.collapsed === "boolean"
        ) {
          savedSidebarWidth = state.width;
          savedCollapsedState = state.collapsed;
        } else {
          console.error("Saved workspace sidebar settings are invalid.");
        }
      } catch (error) {
        console.error("Could not parse saved workspace sidebar settings.", error);
      }
    }

    let sidebarWidth = savedSidebarWidth;
    let visibleSidebarWidth = savedCollapsedState ? 0 : sidebarWidth;
    let pointerStartX = 0;
    let pointerStartWidth = visibleSidebarWidth;
    let pointerMoved = false;

    const persistSidebarState = () => {
      localStorage.setItem(
        SIDEBAR_STORAGE_KEY,
        JSON.stringify({
          width: sidebarWidth,
          collapsed: workspace.hasAttribute("data-sidebar-collapsed"),
        }),
      );
    };

    const setSidebarWidth = (width: number, collapseSidebar = false) => {
      const maximumWidth = Math.min(
        MAX_SIDEBAR_WIDTH,
        Math.max(
          MIN_SIDEBAR_WIDTH,
          workspace.clientWidth -
            WORKSPACE_PADDING * 2 -
            ACTIVITY_BAR_WIDTH -
            RESIZE_HANDLE_WIDTH -
            MAIN_MIN_WIDTH,
        ),
      );
      visibleSidebarWidth = collapseSidebar
        ? 0
        : Math.min(Math.max(width, MIN_SIDEBAR_WIDTH), maximumWidth);
      const collapsed = visibleSidebarWidth === 0;
      workspace.style.setProperty("--sidebar-width", `${visibleSidebarWidth}px`);
      if (visibleSidebarWidth >= MIN_SIDEBAR_WIDTH) sidebarWidth = visibleSidebarWidth;

      workspace.toggleAttribute("data-sidebar-collapsed", collapsed);
      activityButton.setAttribute("aria-expanded", String(!collapsed));

      handle.setAttribute("aria-valuemin", "0");
      handle.setAttribute("aria-valuenow", String(visibleSidebarWidth));
      handle.setAttribute("aria-valuemax", String(maximumWidth));
    };

    setSidebarWidth(visibleSidebarWidth, savedCollapsedState);
    void workspace.offsetWidth;
    workspace.setAttribute("data-sidebar-ready", "");

    activityButton.addEventListener("click", () => {
      const collapsed = !workspace.hasAttribute("data-sidebar-collapsed");
      setSidebarWidth(collapsed ? 0 : sidebarWidth, collapsed);
      persistSidebarState();
    });

    handle.addEventListener("click", () => {
      const dragged = pointerMoved;
      pointerMoved = false;
      if (workspace.hasAttribute("data-sidebar-collapsed") && !dragged) {
        setSidebarWidth(sidebarWidth);
        persistSidebarState();
      }
    });

    handle.addEventListener("pointerdown", (event) => {
      if (event.button !== 0) return;

      pointerStartX = event.clientX;
      pointerStartWidth = visibleSidebarWidth;
      pointerMoved = false;
      handle.setPointerCapture(event.pointerId);
      workspace.toggleAttribute("data-resizing", true);
    });

    handle.addEventListener("pointermove", (event) => {
      if (!handle.hasPointerCapture(event.pointerId)) return;
      pointerMoved ||= Math.abs(event.clientX - pointerStartX) >= 4;
      const requestedWidth =
        event.clientX -
        workspace.getBoundingClientRect().left -
        WORKSPACE_PADDING -
        ACTIVITY_BAR_WIDTH;
      setSidebarWidth(requestedWidth);
    });

    const stopResizing = (event: PointerEvent) => {
      if (handle.hasPointerCapture(event.pointerId)) {
        handle.releasePointerCapture(event.pointerId);
      }
      workspace.removeAttribute("data-resizing");
      if (event.type === "pointercancel") {
        pointerMoved = false;
        setSidebarWidth(pointerStartWidth, pointerStartWidth === 0);
      } else {
        persistSidebarState();
      }
    };

    handle.addEventListener("pointerup", stopResizing);
    handle.addEventListener("pointercancel", stopResizing);

    handle.addEventListener("keydown", (event) => {
      const step = event.shiftKey ? STEP * 3 : STEP;

      if (event.key === "ArrowLeft") {
        event.preventDefault();
        setSidebarWidth(visibleSidebarWidth - step);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        setSidebarWidth(
          workspace.hasAttribute("data-sidebar-collapsed")
            ? sidebarWidth
            : visibleSidebarWidth + step,
        );
      } else if (event.key === "Home") {
        event.preventDefault();
        setSidebarWidth(0, true);
      } else if (event.key === "End") {
        event.preventDefault();
        setSidebarWidth(Number(handle.getAttribute("aria-valuemax")));
      }
      if (["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) {
        persistSidebarState();
      }
    });

    window.addEventListener("resize", () =>
      setSidebarWidth(visibleSidebarWidth, visibleSidebarWidth === 0),
    );
  });
</script>
