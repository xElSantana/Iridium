---
import { FiMoreVertical } from "react-icons/fi";
import { LuPanelLeftClose, LuPanelLeftOpen } from "react-icons/lu";
import WorkspaceContent, {
  type WorkspaceContentLabels,
} from "../WorkspaceContent/WorkspaceContent";
import styles from "./WorkspaceLayout.module.css";

interface Props {
  resizeLabel: string;
  sidebarLabel: string;
  hideSidebarLabel: string;
  showSidebarLabel: string;
  workspaceContentLabels: WorkspaceContentLabels;
}

const { resizeLabel, sidebarLabel, hideSidebarLabel, showSidebarLabel, workspaceContentLabels } =
  Astro.props;
---

<div class={styles.workspace} data-workspace data-task-details-restoring>
  <aside id="workspace-sidebar" class={styles.sidebar} aria-label={sidebarLabel}>
    <div id="workspace-sidebar-content"></div>
    <div class={styles.sidebarFooter}>
      <button
        class={styles.sidebarToggle}
        type="button"
        aria-label={hideSidebarLabel}
        title={hideSidebarLabel}
        aria-expanded="true"
        aria-controls="workspace-sidebar"
        data-collapse-label={hideSidebarLabel}
        data-expand-label={showSidebarLabel}
        data-collapse-sidebar
      >
        <LuPanelLeftClose
          className={`${styles.toggleIcon} ${styles.collapseIcon}`}
          aria-hidden="true"
        />
        <LuPanelLeftOpen
          className={`${styles.toggleIcon} ${styles.expandIcon}`}
          aria-hidden="true"
        />
      </button>
    </div>
  </aside>
  <div
    class={styles.resizeHandle}
    role="separator"
    aria-label={resizeLabel}
    aria-orientation="vertical"
    aria-valuemin="48"
    aria-valuenow="240"
    tabindex="0"
    data-resize-handle
  >
    <FiMoreVertical className={styles.resizeIcon} aria-hidden="true" />
  </div>
  <main class={styles.main}>
    <div class={styles.mainContent}>
      <WorkspaceContent client:load labels={workspaceContentLabels} />
    </div>
  </main>
  <div id="workspace-task-details-separator" class={styles.taskDetailsSeparator}></div>
  <div id="workspace-task-details" class={styles.taskDetailsHost}></div>
</div>

<script>
  const MIN_SIDEBAR_WIDTH = 180;
  const MAX_SIDEBAR_WIDTH = 320;
  const COLLAPSED_SIDEBAR_WIDTH = 48;
  const MAIN_MIN_WIDTH = 160;
  const WORKSPACE_PADDING = 3;
  const RESIZE_HANDLE_WIDTH = 4;
  const STEP = 16;
  const SIDEBAR_STORAGE_KEY = "iridium.workspace.sidebar";

  document.querySelectorAll<HTMLElement>("[data-workspace]").forEach((workspace) => {
    const handle = workspace.querySelector<HTMLElement>("[data-resize-handle]");
    const collapseButton = workspace.querySelector<HTMLButtonElement>("[data-collapse-sidebar]");
    if (!handle || !collapseButton) return;

    let savedSidebarWidth = 240;
    let savedCollapsedState = false;
    const savedSidebarState = localStorage.getItem(SIDEBAR_STORAGE_KEY);
    if (savedSidebarState !== null) {
      try {
        const state: unknown = JSON.parse(savedSidebarState);
        if (
          typeof state === "object" &&
          state !== null &&
          "width" in state &&
          typeof state.width === "number" &&
          Number.isFinite(state.width) &&
          state.width >= MIN_SIDEBAR_WIDTH &&
          "collapsed" in state &&
          typeof state.collapsed === "boolean"
        ) {
          savedSidebarWidth = state.width;
          savedCollapsedState = state.collapsed;
        } else {
          console.error("Saved workspace sidebar settings are invalid.");
        }
      } catch (error) {
        console.error("Could not parse saved workspace sidebar settings.", error);
      }
    }

    let sidebarWidth = savedSidebarWidth;
    let visibleSidebarWidth = savedCollapsedState ? COLLAPSED_SIDEBAR_WIDTH : sidebarWidth;
    let pointerStartX = 0;
    let pointerMoved = false;

    const persistSidebarState = () => {
      localStorage.setItem(
        SIDEBAR_STORAGE_KEY,
        JSON.stringify({
          width: sidebarWidth,
          collapsed: workspace.hasAttribute("data-sidebar-collapsed"),
        }),
      );
    };

    const setSidebarWidth = (width: number) => {
      const maximumWidth = Math.min(
        MAX_SIDEBAR_WIDTH,
        Math.max(
          MIN_SIDEBAR_WIDTH,
          workspace.clientWidth - WORKSPACE_PADDING * 2 - RESIZE_HANDLE_WIDTH - MAIN_MIN_WIDTH,
        ),
      );
      visibleSidebarWidth = Math.min(Math.max(width, COLLAPSED_SIDEBAR_WIDTH), maximumWidth);
      const collapsed = visibleSidebarWidth < MIN_SIDEBAR_WIDTH;
      workspace.style.setProperty("--sidebar-width", `${visibleSidebarWidth}px`);
      workspace.toggleAttribute(
        "data-sidebar-icon-only",
        visibleSidebarWidth === COLLAPSED_SIDEBAR_WIDTH,
      );
      if (!collapsed) sidebarWidth = visibleSidebarWidth;

      if (workspace.hasAttribute("data-sidebar-collapsed") !== collapsed) {
        workspace.toggleAttribute("data-sidebar-collapsed", collapsed);
        const label = collapsed
          ? collapseButton.dataset.expandLabel
          : collapseButton.dataset.collapseLabel;
        if (!label) throw new Error("Sidebar toggle labels are missing.");
        collapseButton.setAttribute("aria-label", label);
        collapseButton.setAttribute("title", label);
        collapseButton.setAttribute("aria-expanded", String(!collapsed));
      }

      handle.setAttribute("aria-valuemin", String(COLLAPSED_SIDEBAR_WIDTH));
      handle.setAttribute("aria-valuenow", String(visibleSidebarWidth));
      handle.setAttribute("aria-valuemax", String(maximumWidth));
    };

    setSidebarWidth(visibleSidebarWidth);
    void workspace.offsetWidth;
    workspace.setAttribute("data-sidebar-ready", "");

    collapseButton.addEventListener("click", () => {
      setSidebarWidth(
        workspace.hasAttribute("data-sidebar-collapsed") ? sidebarWidth : COLLAPSED_SIDEBAR_WIDTH,
      );
      persistSidebarState();
    });

    handle.addEventListener("click", () => {
      const dragged = pointerMoved;
      pointerMoved = false;
      if (workspace.hasAttribute("data-sidebar-collapsed") && !dragged) {
        setSidebarWidth(sidebarWidth);
        persistSidebarState();
      }
    });

    handle.addEventListener("pointerdown", (event) => {
      if (event.button !== 0) return;

      pointerStartX = event.clientX;
      pointerMoved = false;
      handle.setPointerCapture(event.pointerId);
      workspace.toggleAttribute("data-resizing", true);
    });

    handle.addEventListener("pointermove", (event) => {
      if (!handle.hasPointerCapture(event.pointerId)) return;
      pointerMoved ||= Math.abs(event.clientX - pointerStartX) >= 4;
      const requestedWidth =
        event.clientX - workspace.getBoundingClientRect().left - WORKSPACE_PADDING;
      setSidebarWidth(requestedWidth);
    });

    const stopResizing = (event: PointerEvent) => {
      if (handle.hasPointerCapture(event.pointerId)) {
        handle.releasePointerCapture(event.pointerId);
      }
      if (event.type === "pointercancel") pointerMoved = false;
      workspace.removeAttribute("data-resizing");
      if (event.type === "pointerup") persistSidebarState();
    };

    handle.addEventListener("pointerup", stopResizing);
    handle.addEventListener("pointercancel", stopResizing);

    handle.addEventListener("keydown", (event) => {
      const step = event.shiftKey ? STEP * 3 : STEP;

      if (event.key === "ArrowLeft") {
        event.preventDefault();
        setSidebarWidth(visibleSidebarWidth - step);
      } else if (event.key === "ArrowRight") {
        event.preventDefault();
        setSidebarWidth(visibleSidebarWidth + step);
      } else if (event.key === "Home") {
        event.preventDefault();
        setSidebarWidth(COLLAPSED_SIDEBAR_WIDTH);
      } else if (event.key === "End") {
        event.preventDefault();
        setSidebarWidth(Number(handle.getAttribute("aria-valuemax")));
      }
      if (["ArrowLeft", "ArrowRight", "Home", "End"].includes(event.key)) {
        persistSidebarState();
      }
    });

    window.addEventListener("resize", () => setSidebarWidth(visibleSidebarWidth));
  });
</script>
