---
import "../styles/global.css";
import CustomTitleBar from "../components/CustomTitleBar.astro";

import esTranslations from "../i18n/locales/es/translation.json";
import enTranslations from "../i18n/locales/en/translation.json";

const translations = {
  es: esTranslations,
  en: enTranslations,
};

// Detectar idioma en el servidor
const langParam = Astro.url.searchParams.get("lang");
const defaultLang = langParam === "en" || langParam === "es" ? langParam : "es";
---

<!doctype html>
<html lang={defaultLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title id="page-title">{translations[defaultLang].site.title}</title>
    <script is:inline>
      // CRÍTICO: Aplicar tema ANTES de cualquier renderizado para evitar parpadeo
      (function() {
        const savedTheme = localStorage.getItem("iridium-theme");
        document.documentElement.dataset.theme = savedTheme === "dark" ? "dark" : "light";
      })();
    </script>
    <script is:inline define:vars={{ translations, defaultLang }}>
      // Detectar idioma y sincronizar con localStorage
      const urlParams = new URLSearchParams(window.location.search);
      const langParam = urlParams.get("lang");
      const storedLanguage = localStorage.getItem("iridium-language");
      const initialLanguage =
        langParam === "en" || langParam === "es"
          ? langParam
          : storedLanguage === "en" || storedLanguage === "es"
            ? storedLanguage
            : defaultLang;

      // Si el idioma cambió, actualizar localStorage y aplicar traducciones
      if (initialLanguage !== defaultLang) {
        document.documentElement.lang = initialLanguage;
        localStorage.setItem("iridium-language", initialLanguage);
      } else {
        localStorage.setItem("iridium-language", initialLanguage);
      }

      // Definir funciones globales
      window.__TRANSLATIONS__ = translations;

      function getTranslation(key, lang) {
        const keys = key.split(".");
        let value = translations[lang];
        for (const k of keys) {
          if (value && typeof value === "object") {
            value = value[k];
          } else {
            return key;
          }
        }
        return value || key;
      }

      function updatePageLanguage(language) {
        document.documentElement.lang = language;
        const titleEl = document.getElementById("page-title");
        if (titleEl) titleEl.textContent = getTranslation("site.title", language);

        document.querySelectorAll("[data-i18n]").forEach((el) => {
          const key = el.getAttribute("data-i18n");
          if (key) el.textContent = getTranslation(key, language);
        });

        document.querySelectorAll("[data-i18n-aria]").forEach((el) => {
          const key = el.getAttribute("data-i18n-aria");
          if (key) el.setAttribute("aria-label", getTranslation(key, language));
        });
      }

      // Solo actualizar si el idioma es diferente al renderizado
      if (initialLanguage !== defaultLang) {
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", () => updatePageLanguage(initialLanguage));
        } else {
          updatePageLanguage(initialLanguage);
        }
      }

      // Exportar funciones
      window.updatePageLanguage = updatePageLanguage;
      window.getTranslation = getTranslation;
      window.getCurrentLanguage = () => localStorage.getItem("iridium-language") || defaultLang;
    </script>
  </head>
  <body class="min-h-screen min-w-80 bg-surface font-sans text-foreground antialiased">
    <div class="flex min-h-screen flex-col">
      <CustomTitleBar />
      <div class="flex flex-1 items-center justify-center">
        <div class="w-full">
          <slot />
        </div>
      </div>
    </div>
  </body>
</html>
