---
import "../styles/global.css";
import WindowTitleBar from "../components/WindowTitleBar/WindowTitleBar.astro";
import styles from "./Layout.module.css";
import { createTranslator } from "../i18n";

const t = await createTranslator();
---

<!doctype html>
<html lang="es" data-theme="spring">
  <!-- <html lang="es" data-theme="winter"> -->
  <!-- <html lang="es" data-theme="autumn"> -->
  <!-- <html lang="es" data-theme="dark"> -->
  <!-- <html lang="es" data-theme="dark-1"> -->
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/resources/ui/icon.png" />
    <link rel="icon" href="/resources/ui/icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>Iridium</title>
    <link rel="preload" href="/fonts/ComicRelief-Regular.ttf" as="font" type="font/ttf" />
    <link rel="preload" href="/fonts/ComicRelief-Bold.ttf" as="font" type="font/ttf" />
  </head>
  <body>
    <div class={styles.windowFrame}>
      <WindowTitleBar
        labels={{
          controls: t("window.controls"),
          inbox: t("window.inbox"),
          minimize: t("window.minimize"),
          maximize: t("window.maximize"),
          restore: t("window.restore"),
          close: t("window.close"),
        }}
      />
      <slot />
    </div>
  </body>
</html>
