---
import "../styles/global.css";
import WindowTitleBar from "../components/WindowTitleBar/WindowTitleBar.astro";
import { createTranslator } from "../i18n";

const t = await createTranslator();
---

<!doctype html>
<html lang="es" data-theme="spring">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/resources/ui/icon.png" />
    <link rel="icon" href="/resources/ui/icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>Iridium</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Comic+Relief:wght@400;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <WindowTitleBar
      labels={{
        controls: t("window.controls"),
        minimize: t("window.minimize"),
        maximize: t("window.maximize"),
        restore: t("window.restore"),
        close: t("window.close"),
      }}
    />
    <slot />
  </body>
</html>
