---
import "../styles/global.css";
import { getTranslations, resolveLanguage } from "../i18n";
import CustomTitleBar from "../components/CustomTitleBar.astro";

const language = resolveLanguage(Astro.cookies.get("iridium-language")?.value, Astro.url);
const t = await getTranslations(language);
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{t("site.title")}</title>
    <script is:inline>
      const savedTheme = localStorage.getItem("iridium-theme");
      document.documentElement.dataset.theme = savedTheme === "dark" ? "dark" : "light";

      const currentSearchLanguage = new URLSearchParams(window.location.search).get("lang");
      const storedLanguage =
        currentSearchLanguage === "en" || currentSearchLanguage === "es"
          ? currentSearchLanguage
          : localStorage.getItem("iridium-language");

      if (storedLanguage === "en" || storedLanguage === "es") {
        document.documentElement.lang = storedLanguage;
        document.cookie = `iridium-language=${storedLanguage}; path=/; max-age=31536000`;
        localStorage.setItem("iridium-language", storedLanguage);
      }
    </script>
  </head>
  <body class="min-h-screen min-w-80 bg-surface font-sans text-foreground antialiased">
    <div class="flex min-h-screen flex-col">
      <CustomTitleBar />
      <div class="flex flex-1 items-center justify-center">
        <div class="w-full">
          <slot />
        </div>
      </div>
    </div>
  </body>
</html>
