---
import Layout from "../layouts/Layout.astro";
import FolderOptimizer from "../components/FolderOptimizer";
import { getTranslations } from "../i18n";

const t = await getTranslations();
---

<Layout title={t("site.title")}>
  <main class="min-h-screen bg-linear-to-br from-blue-50 to-indigo-100 py-12">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">{t("optimizer.title")}</h1>
        <p class="text-xl text-gray-600">{t("converter.description")}</p>
      </div>

      <FolderOptimizer
        client:load
        translations={{
          selectFolder: t("optimizer.selectFolder"),
          selectedFolder: t("optimizer.selectedFolder"),
          optimize: t("optimizer.optimize"),
          processing: t("optimizer.processing"),
          selectFolderFirst: t("optimizer.selectFolderFirst"),
          formats: {
            label: t("optimizer.formats.label"),
            webp: t("optimizer.formats.webp"),
            avif: t("optimizer.formats.avif"),
            jpg: t("optimizer.formats.jpg"),
            png: t("optimizer.formats.png"),
          },
          quality: {
            label: t("optimizer.quality.label"),
            value: t("optimizer.quality.value"),
          },
          progress: {
            analyzing: t("optimizer.progress.analyzing"),
            optimizing: t("optimizer.progress.optimizing"),
            completed: t("optimizer.progress.completed"),
            imagesProcessed: t("optimizer.progress.imagesProcessed"),
            savedIn: t("optimizer.progress.savedIn"),
          },
          errors: {
            noFolder: t("optimizer.errors.noFolder"),
            optimizationFailed: t("optimizer.errors.optimizationFailed"),
            unknownError: t("optimizer.errors.unknownError"),
            loadPreviewFailed: t("optimizer.errors.loadPreviewFailed"),
          },
          preview: {
            totalImages: t("optimizer.preview.totalImages"),
            showing: t("optimizer.preview.showing"),
          },
        }}
      />
    </div>
  </main>
</Layout>
