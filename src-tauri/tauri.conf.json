{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Iridium",
  "version": "../package.json",
  "identifier": "com.iridium.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:4321/",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Iridium",
        "width": 800,
        "height": 600,
        "create": false,
        "visible": false,
        "devtools": true,
        "backgroundColor": "#ffffff",
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyNEUwMjI4QkI1MkVGQzAKUldUQTcxSzdLQUpPMGwwRXpTbmU0K0F1UDYwSEFmK091M0xLRnUzVmJVeHRIRVVGVGNIcW1vY1kK",
      "endpoints": [
        "https://github.com/xElSantana/Iridium/releases/latest/download/latest.json"
      ]
    }
  }
}
